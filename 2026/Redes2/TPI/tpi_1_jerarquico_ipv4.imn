node n1 {
    type router
    model host
    network-config {
	hostname n34
	!
	interface eth0
	 ip address 130.0.20.2/23
	!
    }
    canvas c1
    iconcoords {77.0 199.0}
    labelcoords {74.33333333333333 247.0}
    services {DefaultRoute SSH}
    interface-peer {eth0 n12}
    custom-config {
	custom-config-id service:DefaultRoute
	custom-command DefaultRoute
	config {
	files=('defaultroute.sh', )
	}
    }
    custom-config {
	custom-config-id service:DefaultRoute:defaultroute.sh
	custom-command defaultroute.sh
	config {
	#!/bin/sh
	ip route add default via 130.0.20.1
	}
    }
}

