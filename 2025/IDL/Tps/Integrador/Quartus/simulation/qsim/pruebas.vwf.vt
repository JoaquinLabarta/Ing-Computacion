initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Integrador_vlg_vec_tst();
// constants                                           
// general purpose registers
reg b0;
reg b1;
reg b2;
reg CLOCK;
reg CONTINUAR;
reg [11:0] treg_DATA;
reg LOADF;
reg LOADI;
reg RECARGAR;
reg START;
reg UP_DOWN;
// wires                                               
wire CYOUT;
wire [11:0] DATA;
wire ERROR;
wire FIN;
wire PAUSE;
wire [11:0] postmux;
wire [11:0] postRegSumador;
wire Q0;
wire Q1;
wire Q2;
wire [11:0] salidaFinal;
wire [11:0] salidaInicial;

wire sampler;                             

// assign statements (if any)                          
assign DATA = treg_DATA;
Integrador i1 (
// port map - connection between master ports and signals/registers   
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.CLOCK(CLOCK),
	.CONTINUAR(CONTINUAR),
	.CYOUT(CYOUT),
	.DATA(DATA),
	.ERROR(ERROR),
	.FIN(FIN),
	.LOADF(LOADF),
	.LOADI(LOADI),
	.PAUSE(PAUSE),
	.postmux(postmux),
	.postRegSumador(postRegSumador),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.RECARGAR(RECARGAR),
	.salidaFinal(salidaFinal),
	.salidaInicial(salidaInicial),
	.START(START),
	.UP_DOWN(UP_DOWN)
);

// CLOCK
always
begin
	CLOCK = 1'b0;
	CLOCK = #10000 1'b1;
	#10000;
end 

// b2
initial
begin
	b2 = 1'b0;
end 

// b1
initial
begin
	b1 = 1'b0;
end 

// b0
initial
begin
	b0 = 1'b1;
end 

// UP_DOWN
initial
begin
	UP_DOWN = 1'b1;
end 
// DATA[ 11 ]
initial
begin
	treg_DATA[11] = 1'b0;
	treg_DATA[11] = #100000 1'bZ;
end 
// DATA[ 10 ]
initial
begin
	treg_DATA[10] = 1'b0;
	treg_DATA[10] = #100000 1'bZ;
end 
// DATA[ 9 ]
initial
begin
	treg_DATA[9] = 1'b0;
	treg_DATA[9] = #100000 1'bZ;
end 
// DATA[ 8 ]
initial
begin
	treg_DATA[8] = 1'b0;
	treg_DATA[8] = #100000 1'bZ;
end 
// DATA[ 7 ]
initial
begin
	treg_DATA[7] = 1'b0;
	treg_DATA[7] = #100000 1'bZ;
end 
// DATA[ 6 ]
initial
begin
	treg_DATA[6] = 1'b0;
	treg_DATA[6] = #100000 1'bZ;
end 
// DATA[ 5 ]
initial
begin
	treg_DATA[5] = 1'b0;
	treg_DATA[5] = #100000 1'bZ;
end 
// DATA[ 4 ]
initial
begin
	treg_DATA[4] = 1'b0;
	treg_DATA[4] = #100000 1'bZ;
end 
// DATA[ 3 ]
initial
begin
	treg_DATA[3] = 1'b0;
	treg_DATA[3] = #60000 1'b1;
	treg_DATA[3] = #40000 1'bZ;
end 
// DATA[ 2 ]
initial
begin
	treg_DATA[2] = 1'b0;
	treg_DATA[2] = #60000 1'b1;
	treg_DATA[2] = #40000 1'bZ;
end 
// DATA[ 1 ]
initial
begin
	treg_DATA[1] = 1'b0;
	treg_DATA[1] = #20000 1'b1;
	treg_DATA[1] = #40000 1'b0;
	treg_DATA[1] = #40000 1'bZ;
end 
// DATA[ 0 ]
initial
begin
	treg_DATA[0] = 1'b0;
	treg_DATA[0] = #20000 1'b1;
	treg_DATA[0] = #40000 1'b0;
	treg_DATA[0] = #40000 1'bZ;
end 

// LOADI
initial
begin
	LOADI = 1'b0;
	LOADI = #20000 1'b1;
	LOADI = #30000 1'b0;
	LOADI = #940000 1'bZ;
end 

// LOADF
initial
begin
	LOADF = 1'b0;
	LOADF = #60000 1'b1;
	LOADF = #30000 1'b0;
end 

// START
initial
begin
	START = 1'b0;
	START = #130000 1'b1;
	START = #30000 1'b0;
end 

// CONTINUAR
initial
begin
	CONTINUAR = 1'b0;
end 

// RECARGAR
initial
begin
	RECARGAR = 1'b0;
end 

Integrador_vlg_sample_tst tb_sample (
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.CLOCK(CLOCK),
	.CONTINUAR(CONTINUAR),
	.DATA(DATA),
	.LOADF(LOADF),
	.LOADI(LOADI),
	.RECARGAR(RECARGAR),
	.START(START),
	.UP_DOWN(UP_DOWN),
	.sampler_tx(sampler)
);

Integrador_vlg_check_tst tb_out(
	.CYOUT(CYOUT),
	.DATA(DATA),
	.ERROR(ERROR),
	.FIN(FIN),
	.PAUSE(PAUSE),
	.postmux(postmux),
	.postRegSumador(postRegSumador),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.salidaFinal(salidaFinal),
	.salidaInicial(salidaInicial),
	.sampler_rx(sampler)
);
endmodule

