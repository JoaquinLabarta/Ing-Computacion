node n1 {
    type router
    model host
    network-config {
	hostname n1
	!
	interface eth1
	 ipv6 address 2001:db8:2::1/64
	 mac address 02:33:44:00:00:33
	!
	interface eth0
	 ipv6 address 2001:db8::128/64
	 mac address 02:33:44:00:00:32
	!
    }
    canvas c1
    iconcoords {239.0 81.0}
    labelcoords {239.0 113.0}
    interface-peer {eth0 n2}
    interface-peer {eth1 n3}
    services {}
    custom-config {
	custom-config-id service:radvd
	custom-command radvd
	config {
	files=('/etc/radvd/radvd.conf', )
	}
    }
    custom-config {
	custom-config-id service:radvd:/etc/radvd/radvd.conf
	custom-command /etc/radvd/radvd.conf
	config {
	interface eth1
	{
	        AdvSendAdvert on;
	        MinRtrAdvInterval 3;
	        MaxRtrAdvInterval 10;
	        AdvDefaultPreference low;
	        AdvHomeAgentFlag off;
	        prefix 2001:db8:2::/64
	        {
	                AdvOnLink on;
	                AdvAutonomous on;
	                AdvRouterAddr on;
	        };
	};
	
	}
    }
}

node n2 {
    type router
    model router
    network-config {
	hostname n2
	!
	interface eth1
	 mac address 02:33:22:00:00:20
	!
	interface eth0
	 mac address 02:33:22:00:34:00
	!
    }
    canvas c1
    iconcoords {535.0 82.0}
    labelcoords {535.0 114.0}
    interface-peer {eth0 n1}
    interface-peer {eth1 n4}
    services {DefaultRoute IPForward}
    custom-config {
	custom-config-id service:radvd
	custom-command radvd
	config {
	files=('/etc/radvd/radvd.conf', )
	}
    }
    custom-config {
	custom-config-id service:radvd:/etc/radvd/radvd.conf
	custom-command /etc/radvd/radvd.conf
	config {
	interface eth1
	{
	        AdvSendAdvert on;
	        MinRtrAdvInterval 3;
	        MaxRtrAdvInterval 10;
	        AdvDefaultPreference low;
	        AdvHomeAgentFlag off;
	        prefix 2001:db8:1::/64
	        {
	                AdvOnLink on;
	                AdvAutonomous on;
	                AdvRouterAddr on;
	        };
	};
	
	}
    }
    custom-config {
	custom-config-id service:DefaultRoute
	custom-command DefaultRoute
	config {
	files=('defaultroute.sh', )
	}
    }
    custom-config {
	custom-config-id service:DefaultRoute:defaultroute.sh
	custom-command defaultroute.sh
	config {
	#!/bin/sh
	# auto-generated by DefaultRoute service (utility.py)
	ip route add default via 2001:db8::128
	
	}
    }
}

node n3 {
    type lanswitch
    network-config {
	hostname sw3
	!
    }
    canvas c1
    iconcoords {190.0 193.0}
    labelcoords {190.0 217.0}
    interface-peer {e0 n1}
    interface-peer {e1 n5}
}

node n4 {
    type hub
    network-config {
	hostname hub4
	!
    }
    canvas c1
    iconcoords {584.0 188.0}
    labelcoords {584.0 212.0}
    interface-peer {e0 n2}
    interface-peer {e1 n6}
}

node n5 {
    type router
    model PC
    network-config {
	hostname n5
	!
	interface eth0
	 mac address 02:22:22:00:00:01
	!
    }
    canvas c1
    iconcoords {59.0 193.0}
    labelcoords {59.0 225.0}
    interface-peer {eth0 n3}
    services {DefaultRoute}
}

node n6 {
    type router
    model PC
    network-config {
	hostname n6
	!
	interface eth0
	 mac address 00:34:c0:00:32:00
	 ipv6 address 2001:db8:1::4/64
	!
    }
    canvas c1
    iconcoords {741.0 187.0}
    labelcoords {741.0 219.0}
    interface-peer {eth0 n4}
    services {DefaultRoute}
}

link l1 {
    nodes {n1 n2}
    bandwidth 0
}

link l2 {
    nodes {n1 n3}
    bandwidth 0
}

link l3 {
    nodes {n2 n4}
    bandwidth 0
}

link l4 {
    nodes {n5 n3}
    bandwidth 0
}

link l5 {
    nodes {n4 n6}
    bandwidth 0
}

canvas c1 {
    name {Canvas1}
}

option global {
    interface_names yes
    ip_addresses yes
    ipv6_addresses yes
    node_labels yes
    link_labels yes
    show_api no
    background_images no
    annotations yes
    grid no
    traffic_start 0
}

option session {
}

