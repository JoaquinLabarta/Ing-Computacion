module tp2_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
// wires                                               
wire B0;
wire B1;
wire B2;
wire B3;
wire B4;
wire B5;
wire B6;
wire B7;
wire B8;
wire CLEAR;
wire salida;
wire salida5;
wire salida30;
wire SB0;
wire SB1;
wire SB2;
wire SB3;
wire SB4;
wire SB5;

wire sampler;                             

// assign statements (if any)                          
tp2 i1 (
// port map - connection between master ports and signals/registers   
	.B0(B0),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.B8(B8),
	.CLEAR(CLEAR),
	.CLK(CLK),
	.salida(salida),
	.salida5(salida5),
	.salida30(salida30),
	.SB0(SB0),
	.SB1(SB1),
	.SB2(SB2),
	.SB3(SB3),
	.SB4(SB4),
	.SB5(SB5)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #10000 1'b1;
	#10000;
end 

tp2_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.sampler_tx(sampler)
);

tp2_vlg_check_tst tb_out(
	.B0(B0),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.B8(B8),
	.CLEAR(CLEAR),
	.salida(salida),
	.salida5(salida5),
	.salida30(salida30),
	.SB0(SB0),
	.SB1(SB1),
	.SB2(SB2),
	.SB3(SB3),
	.SB4(SB4),
	.SB5(SB5),
	.sampler_rx(sampler)
);
endmodule

