// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "06/16/2025 14:00:21"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    tp2
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module tp2_vlg_sample_tst(
	Clock,
	sampler_tx
);
input  Clock;
output sampler_tx;

reg sample;
time current_time;
always @(Clock)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module tp2_vlg_check_tst (
	B0,
	B1,
	B2,
	B3,
	B4,
	B5,
	B6,
	B7,
	B8,
	SQ0,
	SQ1,
	SQ2,
	sampler_rx
);
input  B0;
input  B1;
input  B2;
input  B3;
input  B4;
input  B5;
input  B6;
input  B7;
input  B8;
input  SQ0;
input  SQ1;
input  SQ2;
input sampler_rx;

reg  B0_expected;
reg  B1_expected;
reg  B2_expected;
reg  B3_expected;
reg  B4_expected;
reg  B5_expected;
reg  B6_expected;
reg  B7_expected;
reg  B8_expected;
reg  SQ0_expected;
reg  SQ1_expected;
reg  SQ2_expected;

reg  B0_prev;
reg  B1_prev;
reg  B2_prev;
reg  B3_prev;
reg  B4_prev;
reg  B5_prev;
reg  B6_prev;
reg  B7_prev;
reg  B8_prev;
reg  SQ0_prev;
reg  SQ1_prev;
reg  SQ2_prev;

reg  SQ0_expected_prev;
reg  SQ1_expected_prev;
reg  SQ2_expected_prev;

reg  last_SQ0_exp;
reg  last_SQ1_exp;
reg  last_SQ2_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:12] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 12'b1;
end

// update real /o prevs

always @(trigger)
begin
	B0_prev = B0;
	B1_prev = B1;
	B2_prev = B2;
	B3_prev = B3;
	B4_prev = B4;
	B5_prev = B5;
	B6_prev = B6;
	B7_prev = B7;
	B8_prev = B8;
	SQ0_prev = SQ0;
	SQ1_prev = SQ1;
	SQ2_prev = SQ2;
end

// update expected /o prevs

always @(trigger)
begin
	SQ0_expected_prev = SQ0_expected;
	SQ1_expected_prev = SQ1_expected;
	SQ2_expected_prev = SQ2_expected;
end



// expected SQ0
initial
begin
	SQ0_expected = 1'bX;
end 

// expected SQ1
initial
begin
	SQ1_expected = 1'bX;
end 

// expected SQ2
initial
begin
	SQ2_expected = 1'bX;
end 
// generate trigger
always @(B0_expected or B0 or B1_expected or B1 or B2_expected or B2 or B3_expected or B3 or B4_expected or B4 or B5_expected or B5 or B6_expected or B6 or B7_expected or B7 or B8_expected or B8 or SQ0_expected or SQ0 or SQ1_expected or SQ1 or SQ2_expected or SQ2)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected B0 = %b | expected B1 = %b | expected B2 = %b | expected B3 = %b | expected B4 = %b | expected B5 = %b | expected B6 = %b | expected B7 = %b | expected B8 = %b | expected SQ0 = %b | expected SQ1 = %b | expected SQ2 = %b | ",B0_expected_prev,B1_expected_prev,B2_expected_prev,B3_expected_prev,B4_expected_prev,B5_expected_prev,B6_expected_prev,B7_expected_prev,B8_expected_prev,SQ0_expected_prev,SQ1_expected_prev,SQ2_expected_prev);
	$display("| real B0 = %b | real B1 = %b | real B2 = %b | real B3 = %b | real B4 = %b | real B5 = %b | real B6 = %b | real B7 = %b | real B8 = %b | real SQ0 = %b | real SQ1 = %b | real SQ2 = %b | ",B0_prev,B1_prev,B2_prev,B3_prev,B4_prev,B5_prev,B6_prev,B7_prev,B8_prev,SQ0_prev,SQ1_prev,SQ2_prev);
`endif
	if (
		( SQ0_expected_prev !== 1'bx ) && ( SQ0_prev !== SQ0_expected_prev )
		&& ((SQ0_expected_prev !== last_SQ0_exp) ||
			on_first_change[10])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port SQ0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", SQ0_expected_prev);
		$display ("     Real value = %b", SQ0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[10] = 1'b0;
		last_SQ0_exp = SQ0_expected_prev;
	end
	if (
		( SQ1_expected_prev !== 1'bx ) && ( SQ1_prev !== SQ1_expected_prev )
		&& ((SQ1_expected_prev !== last_SQ1_exp) ||
			on_first_change[11])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port SQ1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", SQ1_expected_prev);
		$display ("     Real value = %b", SQ1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[11] = 1'b0;
		last_SQ1_exp = SQ1_expected_prev;
	end
	if (
		( SQ2_expected_prev !== 1'bx ) && ( SQ2_prev !== SQ2_expected_prev )
		&& ((SQ2_expected_prev !== last_SQ2_exp) ||
			on_first_change[12])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port SQ2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", SQ2_expected_prev);
		$display ("     Real value = %b", SQ2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[12] = 1'b0;
		last_SQ2_exp = SQ2_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module tp2_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clock;
// wires                                               
wire B0;
wire B1;
wire B2;
wire B3;
wire B4;
wire B5;
wire B6;
wire B7;
wire B8;
wire SQ0;
wire SQ1;
wire SQ2;

wire sampler;                             

// assign statements (if any)                          
tp2 i1 (
// port map - connection between master ports and signals/registers   
	.B0(B0),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.B8(B8),
	.Clock(Clock),
	.SQ0(SQ0),
	.SQ1(SQ1),
	.SQ2(SQ2)
);

// Clock
always
begin
	Clock = 1'b0;
	Clock = #10000 1'b1;
	#10000;
end 

tp2_vlg_sample_tst tb_sample (
	.Clock(Clock),
	.sampler_tx(sampler)
);

tp2_vlg_check_tst tb_out(
	.B0(B0),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.B8(B8),
	.SQ0(SQ0),
	.SQ1(SQ1),
	.SQ2(SQ2),
	.sampler_rx(sampler)
);
endmodule

