		&& ((salidaInicial_expected_prev[6] !== last_salidaInicial_exp[6]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[6] = salidaInicial_expected_prev[6];
	end
	if (
		( salidaInicial_expected_prev[7] !== 1'bx ) && ( salidaInicial_prev[7] !== salidaInicial_expected_prev[7] )
		&& ((salidaInicial_expected_prev[7] !== last_salidaInicial_exp[7]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[7] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[7] = salidaInicial_expected_prev[7];
	end
	if (
		( salidaInicial_expected_prev[8] !== 1'bx ) && ( salidaInicial_prev[8] !== salidaInicial_expected_prev[8] )
		&& ((salidaInicial_expected_prev[8] !== last_salidaInicial_exp[8]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[8] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[8] = salidaInicial_expected_prev[8];
	end
	if (
		( salidaInicial_expected_prev[9] !== 1'bx ) && ( salidaInicial_prev[9] !== salidaInicial_expected_prev[9] )
		&& ((salidaInicial_expected_prev[9] !== last_salidaInicial_exp[9]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[9] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[9] = salidaInicial_expected_prev[9];
	end
	if (
		( salidaInicial_expected_prev[10] !== 1'bx ) && ( salidaInicial_prev[10] !== salidaInicial_expected_prev[10] )
		&& ((salidaInicial_expected_prev[10] !== last_salidaInicial_exp[10]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[10] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[10] = salidaInicial_expected_prev[10];
	end
	if (
		( salidaInicial_expected_prev[11] !== 1'bx ) && ( salidaInicial_prev[11] !== salidaInicial_expected_prev[11] )
		&& ((salidaInicial_expected_prev[11] !== last_salidaInicial_exp[11]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port salidaInicial[11] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", salidaInicial_expected_prev);
		$display ("     Real value = %b", salidaInicial_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_salidaInicial_exp[11] = salidaInicial_expected_prev[11];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Integrador_vlg_vec_tst();
// constants                                           
// general purpose registers
reg b0;
reg b1;
reg b2;
reg CLOCK;
reg CONTINUAR;
reg [11:0] DATA;
reg FIN;
reg LOADF;
reg LOADI;
reg RECARGAR;
reg START;
reg UP_DOWN;
// wires                                               
wire ERROR;
wire PAUSE;
wire Q0;
wire Q1;
wire Q2;
wire [11:0] salidaFinal;
wire [11:0] salidaInicial;

wire sampler;                             

// assign statements (if any)                          
Integrador i1 (
// port map - connection between master ports and signals/registers   
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.CLOCK(CLOCK),
	.CONTINUAR(CONTINUAR),
	.DATA(DATA),
	.ERROR(ERROR),
	.FIN(FIN),
	.LOADF(LOADF),
	.LOADI(LOADI),
	.PAUSE(PAUSE),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.RECARGAR(RECARGAR),
	.salidaFinal(salidaFinal),
	.salidaInicial(salidaInicial),
	.START(START),
	.UP_DOWN(UP_DOWN)
);

// b0
initial
begin
	b0 = 1'b0;
end 

// b1
initial
begin
	b1 = 1'b0;
end 

// b2
initial
begin
	b2 = 1'b1;
end 

// CLOCK
always
begin
	CLOCK = 1'b0;
	CLOCK = #10000 1'b1;
	#10000;
end 
// DATA[ 11 ]
initial
begin
	DATA[11] = 1'b0;
end 
// DATA[ 10 ]
initial
begin
	DATA[10] = 1'b0;
	DATA[10] = #50000 1'b1;
	DATA[10] = #70000 1'b0;
end 
// DATA[ 9 ]
initial
begin
	DATA[9] = 1'b0;
end 
// DATA[ 8 ]
initial
begin
	DATA[8] = 1'b0;
	DATA[8] = #320000 1'b1;
	DATA[8] = #100000 1'b0;
end 
// DATA[ 7 ]
initial
begin
	DATA[7] = 1'b0;
end 
// DATA[ 6 ]
initial
begin
	DATA[6] = 1'b0;
	DATA[6] = #120000 1'b1;
	DATA[6] = #100000 1'b0;
end 
// DATA[ 5 ]
initial
begin
	DATA[5] = 1'b0;
	DATA[5] = #120000 1'b1;
	DATA[5] = #100000 1'b0;
end 
// DATA[ 4 ]
initial
begin
	DATA[4] = 1'b0;
end 
// DATA[ 3 ]
initial
begin
	DATA[3] = 1'b0;
end 
// DATA[ 2 ]
initial
begin
	DATA[2] = 1'b0;
end 
// DATA[ 1 ]
initial
begin
	DATA[1] = 1'b0;
end 
// DATA[ 0 ]
initial
begin
	DATA[0] = 1'b0;
	DATA[0] = #10000 1'b1;
	DATA[0] = #10000 1'b0;
end 

// FIN
initial
begin
	FIN = 1'b0;
end 

// LOADF
initial
begin
	LOADF = 1'b0;
	LOADF = #70000 1'b1;
	LOADF = #20000 1'b0;
end 

// LOADI
initial
begin
	LOADI = 1'b0;
	LOADI = #10000 1'b1;
	LOADI = #10000 1'b0;
	LOADI = #30000 1'b1;
	LOADI = #20000 1'b0;
end 

// RECARGAR
initial
begin
	RECARGAR = 1'b0;
end 

// CONTINUAR
initial
begin
	CONTINUAR = 1'b0;
end 

// START
initial
begin
	START = 1'b0;
	START = #240000 1'b1;
	START = #70000 1'b0;
end 

// UP_DOWN
initial
begin
	UP_DOWN = 1'b1;
end 

Integrador_vlg_sample_tst tb_sample (
	.b0(b0),
	.b1(b1),
	.b2(b2),
	.CLOCK(CLOCK),
	.CONTINUAR(CONTINUAR),
	.DATA(DATA),
	.FIN(FIN),
	.LOADF(LOADF),
	.LOADI(LOADI),
	.RECARGAR(RECARGAR),
	.START(START),
	.UP_DOWN(UP_DOWN),
	.sampler_tx(sampler)
);

Integrador_vlg_check_tst tb_out(
	.ERROR(ERROR),
	.PAUSE(PAUSE),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.salidaFinal(salidaFinal),
	.salidaInicial(salidaInicial),
	.sampler_rx(sampler)
);
endmodule

