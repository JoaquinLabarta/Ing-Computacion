{
    "configurations": [
        {
            "name": "AVR",
            "includePath": [
                "${workspaceFolder}/TP_LED_RGB",
                "${workspaceFolder}/**",
                "/usr/lib/avr/include",
                "/usr/lib/gcc/avr/14.3.0/include",
                "/usr/lib/gcc/avr/14.3.0/include-fixed"
            ],
            "defines": [
                "__AVR_ATmega328P__",
                "F_CPU=16000000UL"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "compilerArgs": [
                "-mmcu=atmega328p"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
