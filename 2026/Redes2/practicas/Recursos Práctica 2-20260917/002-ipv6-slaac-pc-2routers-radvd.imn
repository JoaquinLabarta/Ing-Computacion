node n1 {
    type router
    model host
    network-config {
	hostname n1
	!
	interface eth0
	 ipv6 address 3ffe:8070:1011:100::1234/64
	!
	interface eth1
	!
    }
    canvas c1
    iconcoords {377.0 82.0}
    labelcoords {377.0 114.0}
    interface-peer {eth0 n2}
    interface-peer {eth1 n3}
    custom-config {
	custom-config-id service:DefaultRoute
	custom-command DefaultRoute
	config {
	files=('defaultroute.sh', )
	}
    }
    custom-config {
	custom-config-id service:DefaultRoute:defaultroute.sh
	custom-command defaultroute.sh
	config {
	#!/bin/sh
	# auto-generated by DefaultRoute service (utility.py)
	#ip route add default via 3ffe:8070:1011:100::1
	
	#sysctl net.ipv6.conf.eth0.addr_gen_mode=0
	#sysctl net.ipv6.conf.eth0.addr_gen_mode=1
	#sysctl net.ipv6.conf.eth0.addr_gen_mode=2
	#sysctl net.ipv6.conf.eth0.addr_gen_mode=3
	
	#sysctl net.ipv6.conf.eth0.use_tempaddr=0
	#sysctl net.ipv6.conf.eth0.use_tempaddr=1
	#sysctl net.ipv6.conf.eth0.use_tempaddr=2
	}
    }
    services {DefaultRoute}
}

node n2 {
    type router
    model router
    network-config {
	hostname n2
	!
	interface eth0
	 ipv6 address 3ffe:8070:1011:100::1/64
	!
    }
    canvas c1
    iconcoords {222.0 178.0}
    labelcoords {222.0 210.0}
    interface-peer {eth0 n1}
    custom-config {
	custom-config-id service:radvd
	custom-command radvd
	config {
	files=('/etc/radvd/radvd.conf', )
	}
    }
    custom-config {
	custom-config-id service:radvd:/etc/radvd/radvd.conf
	custom-command /etc/radvd/radvd.conf
	config {
	# auto-generated by RADVD service (utility.py)
	interface eth0
	{
	        AdvSendAdvert on;
	        MinRtrAdvInterval 3;
	        MaxRtrAdvInterval 10;
	        AdvDefaultPreference low;
	        AdvHomeAgentFlag off;
	        prefix 3ffe:8070:1011:100::/64
	        {
	                AdvOnLink on;
	                AdvAutonomous on;
	                AdvRouterAddr on;
	        };
	};
	
	}
    }
    services {IPForward radvd}
}

node n3 {
    type router
    model router
    network-config {
	hostname n3
	!
	interface eth0
	 ipv6 address 2818:4fde:5100:0::1/64
	!
    }
    canvas c1
    iconcoords {543.0 180.0}
    labelcoords {543.0 212.0}
    interface-peer {eth0 n1}
    custom-config {
	custom-config-id service:radvd
	custom-command radvd
	config {
	files=('/etc/radvd/radvd.conf', )
	}
    }
    custom-config {
	custom-config-id service:radvd:/etc/radvd/radvd.conf
	custom-command /etc/radvd/radvd.conf
	config {
	# auto-generated by RADVD service (utility.py)
	interface eth0
	{
	        AdvSendAdvert on;
	        MinRtrAdvInterval 3;
	        MaxRtrAdvInterval 10;
	        AdvDefaultPreference low;
	        AdvHomeAgentFlag off;
	        prefix 2818:4fde:5100::/64
	        {
	                AdvOnLink on;
	                AdvAutonomous on;
	                AdvRouterAddr on;
	        };
	};
	
	}
    }
    services {IPForward radvd}
}

link l1 {
    nodes {n1 n2}
    bandwidth 0
}

link l2 {
    nodes {n1 n3}
    bandwidth 0
}

canvas c1 {
    name {Canvas1}
}

option global {
    interface_names no
    ip_addresses yes
    ipv6_addresses yes
    node_labels yes
    link_labels yes
    show_api no
    background_images no
    annotations yes
    grid yes
    traffic_start 0
}

option session {
}

