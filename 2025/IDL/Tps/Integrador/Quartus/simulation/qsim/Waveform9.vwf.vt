`timescale 1 ps/ 1 ps
module BlockPruebaaa_vlg_sample_tst(
	A,
	C,
	DATA,
	Z,
	sampler_tx
);
input [11:0] A;
input  C;
input [11:0] DATA;
input [11:0] Z;
output sampler_tx;

reg sample;
time current_time;
always @(A or C or DATA or Z)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

