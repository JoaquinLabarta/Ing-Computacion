`timescale 1 ps/ 1 ps
module Integrador_vlg_sample_tst(
	b0,
	b1,
	b2,
	CLOCK,
	CONTINUAR,
	DATA,
	FIN,
	LOADF,
	LOADI,
	RECARGAR,
	START,
	UP_DOWN,
	sampler_tx
);
input  b0;
input  b1;
input  b2;
input  CLOCK;
input  CONTINUAR;
input [11:0] DATA;
input  FIN;
input  LOADF;
input  LOADI;
input  RECARGAR;
input  START;
input  UP_DOWN;
output sampler_tx;

reg sample;
time current_time;
always @(b0 or b1 or b2 or CLOCK or CONTINUAR or DATA or FIN or LOADF or LOADI or RECARGAR or START or UP_DOWN)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

