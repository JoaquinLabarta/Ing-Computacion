node n22 {
    type router
    model router
    network-config {
	hostname n5-spine1
	!
	interface eth0
	 ip address 130.0.20.1/23
	!
	interface eth1
	 ip address 130.0.26.2/30
	!
	interface eth2
	 ip address 130.0.26.10/30
	!
	interface eth3
	 ip address 130.0.26.18/30
	!
	interface eth4
	 ip address 130.0.26.26/30
	!
    }
    canvas c1
    iconcoords {362.0 256.0}
    labelcoords {367.3333333333333 234.0}
    services {IPForward StaticRoute}
    interface-peer {eth0 n12}
    interface-peer {eth1 n25}
    interface-peer {eth2 n28}
    interface-peer {eth3 n31}
    interface-peer {eth4 n34}
    custom-config {
	custom-config-id service:StaticRoute
	custom-command StaticRoute
	config {
	files=('staticroute.sh', )
	}
    }
    custom-config {
	custom-config-id service:StaticRoute:staticroute.sh
	custom-command staticroute.sh
	config {
	#!/bin/sh
	# n5-spine1: una ruta por Net (sin ruta por defecto)
	/sbin/ip route add 130.0.16.0/22 via 130.0.26.1
	/sbin/ip route add 130.0.22.0/24 via 130.0.26.9
	/sbin/ip route add 130.0.23.0/24 via 130.0.26.17
	/sbin/ip route add 130.0.24.0/24 via 130.0.26.25
	# Net6 por leaf3
	/sbin/ip route add 130.0.25.0/24 via 130.0.26.17
	# Enlaces leaf-spine2 (solo para poder hacer ping a esas interfaces)
	/sbin/ip route add 130.0.26.4/30 via 130.0.26.1
	/sbin/ip route add 130.0.26.12/30 via 130.0.26.9
	/sbin/ip route add 130.0.26.20/30 via 130.0.26.17
	/sbin/ip route add 130.0.26.28/30 via 130.0.26.25
	}
    }
}

